# Copy to .env and fill in. .env is git-ignored.
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=your-username
# Generate under Nextcloud: Settings -> Security -> Devices & sessions -> Create new app password
NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Folder on the server to compare against (blank = whole account).
NEXTCLOUD_REMOTE_ROOT=InstantUpload/DCIM/Camera/2026

# Where the photos live on the phone.
PHONE_PHOTO_ROOT=/sdcard/DCIM/Camera

# Only compare local files whose name contains this (blank = all).
# The phone stores every year flat in one folder, so scope to match the remote year.
PHONE_PHOTO_NAME_CONTAINS=_2026

# Only needed if more than one device is attached (see: adb devices).
ADB_SERIAL=
